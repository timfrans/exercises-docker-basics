
FROM ubuntu

ENV REACT_APP_BACKEND_URL="http://localhost:8080"
EXPOSE 5001

WORKDIR ./app

RUN apt-get update && apt-get install -y curl

COPY 1_12 .
RUN curl -sL https://deb.nodesource.com/setup_16.x | bash && apt install -y nodejs && npm i

RUN npm i -g serve

RUN npm run build

CMD ["serve", "-s", "-l", "5001", "build"]
